# 复制为 .env 后按需修改；未设置的项使用 app/core/config.py 中的默认值。

# --- 运行环境 ---
ENVIRONMENT=dev            # dev | prod | test
DEBUG=false                # prod 下请保持 false
APP_NAME=Team Roll

# --- 安全 ---
# 生产环境必须换成随机值：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-secret-change-me
# 首次启动时用它创建超级管理员；已有管理员时忽略。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_TTL_MINUTES=120
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
# 部署在 Nginx 等反代之后时设为 true，否则记录到的是代理 IP
TRUST_PROXY_HEADERS=false
# 跨域白名单，留空即同源部署
CORS_ALLOW_ORIGINS=

# --- 限流（次 / 窗口秒） ---
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
ROLL_RATE_LIMIT=12
ROLL_RATE_WINDOW_SECONDS=60

# --- 数据库 ---
# 只支持同步驱动；写 sqlite+aiosqlite 会被自动降级为 sqlite
DATABASE_URL=sqlite:///./team_roll.db
DATABASE_AUTO_MIGRATE=true
SQL_ECHO=false
# 1.x 的记录以本机时钟的裸时间写入，迁移时按该偏移回拨到真实 UTC
LEGACY_LOCAL_OFFSET_MINUTES=480

# --- Roll 规则默认值 ---
ROLL_MIN_VALUE=1
ROLL_MAX_VALUE=10000
ACTIVITY_NAME_MAX_LENGTH=80
PARTICIPANT_NAME_MAX_LENGTH=32
DESCRIPTION_MAX_LENGTH=2000

# --- HTTP 与实时通道 ---
HOST=0.0.0.0
PORT=8803
# 用于 sitemap/canonical 的对外地址，留空则取请求 Host
PUBLIC_BASE_URL=
WS_HEARTBEAT_SECONDS=30
WS_MAX_CONNECTIONS_PER_ACTIVITY=500
